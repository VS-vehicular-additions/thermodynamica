{
  "schemaVersion": 1,
  "id": "thermodynamica",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.Tribulla.thermodynamica.fabric.FabricThermodynamica"
    ],
    "client": [
      "com.Tribulla.thermodynamica.fabric.client.FabricThermodynamicaClient"
    ]
  },
  "mixins": [
    "thermodynamica.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
